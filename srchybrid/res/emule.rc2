//
// emule.RC2 - Ressourcen, die Microsoft Visual C++ nicht direkt bearbeitet
//
#pragma code_page(65001)

#ifdef APSTUDIO_INVOKED
#error this file is not editable by Microsoft Visual C++
#endif //APSTUDIO_INVOKED

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/////////////////////////////////////////////////////////////////////////////
// Fügen Sie hier manuell bearbeitete Ressourcen hinzu...

/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
        FILEVERSION         EMULE_NEXT_VERSION_MJR,EMULE_NEXT_VERSION_MIN,EMULE_NEXT_VERSION_PATCH,EMULE_NEXT_VERSION_BUILD
        PRODUCTVERSION      EMULE_NEXT_VERSION_MJR,EMULE_NEXT_VERSION_MIN,EMULE_NEXT_VERSION_PATCH,EMULE_NEXT_VERSION_BUILD
        FILEFLAGSMASK       VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
        FILEFLAGS           VS_FF_DEBUG | VS_FF_PRIVATEBUILD | VS_FF_PRERELEASE
#elif defined(_BETA) || defined(_DEVBUILD)
        FILEFLAGS           VS_FF_PRERELEASE
#else
        FILEFLAGS           0x0L // final version
#endif
        FILEOS              VOS__WINDOWS32
        FILETYPE            VFT_APP
        FILESUBTYPE         0x0L // not used
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0" // Lang=US English, CharSet=Unicode
        BEGIN
            VALUE "CompanyName", "eMule Next community build"
            VALUE "FileDescription", "eMule Next"
            VALUE "FileVersion", EMULE_NEXT_VERSION_STRING
            VALUE "InternalName", "eMuleNext.exe"
            VALUE "LegalCopyright", "Copyright © 2002-2026 Merkur - Read license.txt for more infos."
            VALUE "OriginalFilename", "eMuleNext.exe"
            VALUE "ProductName", "eMule Next"
            VALUE "ProductVersion", EMULE_NEXT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200 // Lang=US English, CharSet=Unicode
    END
END

